# Copy this file to `.env` on each machine and replace the placeholder paths.
# The real `.env` is machine-specific and intentionally ignored by git.

# Prepared BigEarthNet.txt data. These paths must already exist after following
# the dataset preparation instructions.
BIGEARTHNET_V2_LMDB_ROOT=/path/to/BigEarthNet-v2-lmdb
BIGEARTHNET_TXT_PARQUET_PATH=/path/to/BigEarthNet.txt.parquet

# Frozen side encoders. `scripts/download_artifacts.py` can write these model
# artifacts here, and training later loads them from the same paths.
BIGEARTHNET_ENCODER_DIR=/path/to/mobilevit_s-all-v0.2.0
SATCLIP_CHECKPOINT_PATH=/path/to/satclip-vit16-l10.ckpt

# Hugging Face cache for Qwen/Unsloth model snapshots. Keep this on persistent
# storage because it is populated by the artifact downloader.
HF_HOME=/path/to/huggingface-cache

# Training output root. Each Slurm job creates its own run directory below this:
#   $FINETUNING_OUTPUT_ROOT/bigearthnet_$SLURM_JOB_ID
# QLoRA adapter artifacts are created under:
#   $FINETUNING_OUTPUT_ROOT/bigearthnet_$SLURM_JOB_ID/adapter
FINETUNING_OUTPUT_ROOT=/path/to/finetuning_outputs
