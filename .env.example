# Copy to `.env` and replace the placeholders. Directory examples end in `/`;
# file examples do not.

# Prepared BigEarthNet.txt data. These paths must already exist.
# Directory of the BigEarthNet-v2 LMDB environment, e.g. `BENv2.lmdb/`.
BIGEARTHNET_V2_LMDB_ROOT=/absolute/path/to/BENv2.lmdb/
# File path to the BigEarthNet.txt parquet metadata.
BIGEARTHNET_TXT_PARQUET_PATH=/absolute/path/to/BigEarthNet.txt.parquet
# Required for location-redacted caption-control and ablation runs. Leave empty
# for main BigEarthNet.txt caption runs.
BENTXT_LOCATION_REDACTED_CAPTION_FILE=

# Frozen side encoders. `scripts/download_artifacts.py` can populate these.
# Directory containing, or to be populated with, `config.json` and
# `model.safetensors` for the BigEarthNet MobileViT encoder.
BIGEARTHNET_ENCODER_DIR=/absolute/path/to/mobilevit_s-all-v0.2.0/
# File path to the SatCLIP checkpoint. The filename must be this exact `.ckpt`.
SATCLIP_CHECKPOINT_PATH=/absolute/path/to/satclip-vit16-l10.ckpt
# Finer-resolution checkpoint used by the selected loc_embed/additive conditions.
SATCLIP_L40_CHECKPOINT_PATH=/absolute/path/to/satclip-vit16-l40.ckpt

# Hugging Face cache root directory for Qwen/Unsloth snapshots.
HF_HOME=${HOME}/.cache/huggingface/

# Training output root directory. Each Slurm run gets one QLoRA adapter bundle:
#   ${FINETUNING_OUTPUT_ROOT}bigearthnet_$SLURM_JOB_ID/qlora_adapter
FINETUNING_OUTPUT_ROOT=/absolute/path/to/finetuning_outputs/

# Evaluation export root directory. Keep this separate from finetuning outputs.
EVALUATION_OUTPUT_ROOT=/absolute/path/to/evaluation_outputs/

# Isolated direct-Transformers environment for the supplementary CLAIR judge.
# Qwen3.8's prequantized checkpoint requires the matching Transformers release;
# do not point this at the older Unsloth training environment.
CLAIR_PYTHON=
CLAIR_TRANSFORMERS_VERSION=5.15.1

# Slurm default partition for this machine. Override per run with
# `--partition` instead of editing `.env` between submissions.
SLURM_DEFAULT_PARTITION=big_job

# Optional local-only sync settings for pulling lightweight logs and
# TensorBoard files from the server with `scripts/sync_server_runs.sh`.
SERVER_SYNC_HOST=user@server.example.edu
SERVER_REPO_ROOT=/absolute/server/path/to/repo
SERVER_FINETUNING_OUTPUT_ROOT=/absolute/server/path/to/finetuning_outputs/
SERVER_EVALUATION_OUTPUT_ROOT=/absolute/server/path/to/evaluation_outputs/
